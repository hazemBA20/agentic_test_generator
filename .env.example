# Copy to .env and fill in. .env is gitignored and must never be committed.

# Target API under test (the generated suite sends requests here).
API_BASE_URL=https://api.example.com

# Credentials. Which ones are needed is decided by the spec's security schemes;
a plan never carries credentials itself - the runner attaches them.

# API key, attached under the scheme's declared header (default X-API-KEY).
DIGIEXPERT_API_KEY=

# Bearer auth: either a static token...
# AUTH_TOKEN=
# ...or a login flow used once per run when no static token is set. The token
# is read from access_token / token / jwt in the response.
# AUTH_TOKEN_URL=https://sso.example.com/login
# AUTH_USERNAME=
# AUTH_PASSWORD=

# HTTP basic auth, when an operation requires it.
# AUTH_BASIC_USERNAME=
# AUTH_BASIC_PASSWORD=

# Model providers. Only the keys for the providers you use are needed.
GEMINI_API_KEY=
groq_key=
OPENROUTER_API_KEY=

# Optional model overrides (sensible defaults are baked in).
# GOOGLE_MODEL=gemini-3.5-flash
# GROQ_MODEL=qwen/qwen3.8-27b
# REWRITE_MODEL=deepseek/deepseek-v4-flash
