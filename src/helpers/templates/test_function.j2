{% macro assert_response_line(name, expected_response) -%}
assert_response(resp.json(), {{ expected_response|pyrepr }}, context={{ (name ~ ": ")|pyrepr }})
{%- endmacro %}

def {{ name }}():
    """{{ description }}"""
{% if invalid_reasons %}
    pytest.skip({{ invalid_reasons|pyrepr }})
{% else %}
    resp = send_request(
        method={{ method|pyrepr }},
        path={{ path|pyrepr }},
        request_body={{ request_body|pyrepr }},
        content_type={{ content_type|pyrepr }},
        path_params={{ path_params|pyrepr }},
        query_params={{ query_params|pyrepr }},
        headers={{ headers|pyrepr }},
        requires_api_key={{ requires_api_key|pyrepr }},
        requires_jwt={{ requires_jwt|pyrepr }},
    )
    assert resp.status_code == {{ expected_status_code|pyrepr }}, (
        f"expected {{ expected_status_code|pyrepr }}, got {resp.status_code} — body: {resp.text}"
    )
{% if expected_response is not none %}
    {{ assert_response_line(name, expected_response) }}
{% else %}
    # no response body assertions for this scenario
{% endif %}
{% endif %}
